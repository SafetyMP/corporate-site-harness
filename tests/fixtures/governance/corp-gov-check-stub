#!/usr/bin/env python3
"""Test stub for corp-gov-check: assist splash + heavy validate/write-receipt."""

from __future__ import annotations

import json
import sys
from pathlib import Path

from corp_harness.model import ContractError
from corp_harness.swift_gov import (
    ASSIST_COMMANDS,
    HEAVY_COMMANDS,
    build_assist_payload,
    build_validate_action_payload,
    build_write_receipt_payload,
)


def main(argv: list[str]) -> int:
    if not argv:
        print(
            "usage: corp-gov-check-stub <assist-cmd|validate-action|write-receipt> "
            "--root PATH [--to PHASE] [--path REL ...] [--action NAME]",
            file=sys.stderr,
        )
        return 2
    command = argv[0]
    root: Path | None = None
    to_phase: str | None = None
    paths: list[str] = []
    action: str | None = None
    idx = 1
    while idx < len(argv):
        if argv[idx] == "--root" and idx + 1 < len(argv):
            root = Path(argv[idx + 1])
            idx += 2
            continue
        if argv[idx] == "--to" and idx + 1 < len(argv):
            to_phase = argv[idx + 1]
            idx += 2
            continue
        if argv[idx] == "--path" and idx + 1 < len(argv):
            paths.append(argv[idx + 1])
            idx += 2
            continue
        if argv[idx] == "--action" and idx + 1 < len(argv):
            action = argv[idx + 1]
            idx += 2
            continue
        print(f"unknown argument: {argv[idx]}", file=sys.stderr)
        return 2
    if root is None:
        print("--root is required", file=sys.stderr)
        return 2

    try:
        if command == "validate-action":
            if not action:
                raise ContractError("validate-action requires --action")
            payload = build_validate_action_payload(root, action)
        elif command == "write-receipt":
            payload = build_write_receipt_payload(root)
        elif command in ASSIST_COMMANDS:
            payload = build_assist_payload(
                command,
                root,
                to_phase=to_phase,
                paths=paths or None,
            )
        else:
            raise ContractError(
                f"unsupported command: {command!r} "
                f"(assist={sorted(ASSIST_COMMANDS)} heavy={sorted(HEAVY_COMMANDS)})"
            )
    except ContractError as exc:
        print(
            json.dumps(
                {
                    "ok": False,
                    "error": str(exc),
                    "assist": command in ASSIST_COMMANDS,
                    "mutation": False,
                },
                indent=2,
                sort_keys=True,
            )
        )
        return 3
    print(json.dumps(payload, indent=2, sort_keys=True))
    return 0 if payload.get("ok") else 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
